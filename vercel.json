{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "boards/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/server.js" },
    { "src": "/(codenames|setup|spymaster|jeopardy)/?", "dest": "/server.js" },
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/boards/(.*)", "dest": "/boards/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
